<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Background -->
  <circle cx="100" cy="100" r="100" fill="#ffffff"/>
  
  <!-- Central node -->
  <circle cx="100" cy="100" r="14" fill="#0a0a0a"/>
  
  <!-- Radiating spokes — main axis -->
  <line x1="100" y1="20" x2="100" y2="86" stroke="#0a0a0a" stroke-width="7" stroke-linecap="round"/>
  <line x1="100" y1="114" x2="100" y2="180" stroke="#0a0a0a" stroke-width="7" stroke-linecap="round"/>
  <line x1="20" y1="100" x2="86" y2="100" stroke="#0a0a0a" stroke-width="7" stroke-linecap="round"/>
  <line x1="114" y1="100" x2="180" y2="100" stroke="#0a0a0a" stroke-width="7" stroke-linecap="round"/>
  
  <!-- Diagonal spokes -->
  <line x1="43" y1="43" x2="86" y2="86" stroke="#0a0a0a" stroke-width="5" stroke-linecap="round"/>
  <line x1="114" y1="114" x2="157" y2="157" stroke="#0a0a0a" stroke-width="5" stroke-linecap="round"/>
  <line x1="157" y1="43" x2="114" y2="86" stroke="#0a0a0a" stroke-width="5" stroke-linecap="round"/>
  <line x1="86" y1="114" x2="43" y2="157" stroke="#0a0a0a" stroke-width="5" stroke-linecap="round"/>
  
  <!-- Outer nodes -->
  <circle cx="100" cy="22" r="8" fill="#0a0a0a"/>
  <circle cx="100" cy="178" r="8" fill="#0a0a0a"/>
  <circle cx="22" cy="100" r="8" fill="#0a0a0a"/>
  <circle cx="178" cy="100" r="8" fill="#0a0a0a"/>
  <circle cx="45" cy="45" r="6" fill="#0a0a0a"/>
  <circle cx="155" cy="155" r="6" fill="#0a0a0a"/>
  <circle cx="155" cy="45" r="6" fill="#0a0a0a"/>
  <circle cx="45" cy="155" r="6" fill="#0a0a0a"/>
</svg>
